<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var \Application\Form\ContactForm $form
 * @var array $successMessages
 * @var array $errorMessages
 */

$form->prepare();
?>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h1 class="mb-4">Formulario de contacto</h1>
            <p class="text-muted">
                Envíanos un mensaje y te responderemos lo antes posible.
            </p>

            <!-- Mensajes flash de éxito -->
            <?php if (! empty($successMessages)): ?>
                <?php foreach ($successMessages as $message): ?>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <?= $this->escapeHtml($message) ?>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>

            <!-- Mensajes flash de error -->
            <?php if (! empty($errorMessages)): ?>
                <?php foreach ($errorMessages as $message): ?>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <?= $this->escapeHtml($message) ?>
                    </div>
                <?php endforeach; ?>
            <?php endif; ?>

            <?= $this->form()->openTag($form->setAttribute('novalidate', 'novalidate')) ?>

                <!-- Campo: nombre -->
                <div class="mb-3">
                    <?= $this->formLabel($form->get('nombre')) ?>
                    <?= $this->formElement($form->get('nombre')) ?>
                    <?= $this->formElementErrors($form->get('nombre'), ['class' => 'text-danger small']) ?>
                </div>

                <!-- Campo: email -->
                <div class="mb-3">
                    <?= $this->formLabel($form->get('email')) ?>
                    <?= $this->formElement($form->get('email')) ?>
                    <?= $this->formElementErrors($form->get('email'), ['class' => 'text-danger small']) ?>
                </div>

                <!-- Campo: mensaje -->
                <div class="mb-3">
                    <?= $this->formLabel($form->get('mensaje')) ?>
                    <?= $this->formElement($form->get('mensaje')) ?>
                    <?= $this->formElementErrors($form->get('mensaje'), ['class' => 'text-danger small']) ?>
                </div>

                <!-- Botón -->
                <div class="mb-3">
                    <?= $this->formElement($form->get('submit')) ?>
                </div>

            <?= $this->form()->closeTag() ?>

        </div>
    </div>
</div>